# Private command-scoped connection. Use exactly fleet_migrator for migrate;
# use exactly fleet_writer for health, ingest, and serve.
# Do not commit credentials or expose this variable to the public demo process.
FLEET_RECALL_DATABASE_URL=postgresql://fleet_writer:password@host:26257/fleet_recall?sslmode=verify-full

# The demo accepts this dedicated publication capability instead of the private
# URL above. Its username and database are fixed; enable only in the demo
# process, where FLEET_RECALL_DATABASE_URL and every other private/test database
# variable must be absent.
# FLEET_RECALL_PUBLICATION_DATABASE_URL=postgresql://fleet_publication:password@host:26257/fleet_recall?sslmode=verify-full

# LocalStack/Compose may set this to 1 only with localhost, loopback, or the
# Compose service hostname `cockroach`; production URLs always verify TLS.
# FLEET_RECALL_ALLOW_INSECURE_LOCAL_DATABASE=1

# Stable namespace used to isolate one organization or fleet. Generate a
# different UUID for each real fleet; this non-nil value is only a demo sample.
FLEET_RECALL_TENANT_ID=0198a849-f6ae-7d61-9800-000000000001

# Deployment-bound identity. MCP callers may assert the same project/agent,
# choose a session subdivision, but cannot reroute identity or visibility.
FLEET_RECALL_PROJECT=default
FLEET_RECALL_AGENT=operator
FLEET_RECALL_MAX_CONNECTIONS=16
# Stable logical registry name. This is not resolved over the network.
FLEET_RECALL_EMBEDDING_MODEL=minishlab/potion-retrieval-32M
# Local model2vec directory baked into the runtime image. It must contain
# config.json, model.safetensors, and tokenizer.json as regular files.
FLEET_RECALL_EMBEDDING_MODEL_PATH=/opt/ostk/models/potion-retrieval-32M
# Versioned digest printed by `ostk-fleet-recall model-digest <bundle-path>`.
# Replace this placeholder before running migrate, health, serve, or ingest.
FLEET_RECALL_EMBEDDING_MODEL_SHA256=REPLACE_WITH_MODEL_DIGEST
RUST_LOG=ostk_fleet_recall=info

# Remote HTTP MCP (serve --http 127.0.0.1:8080). See docs/REMOTE_PLANE.md.
# Resource is the externally visible /mcp URL; HTTPS except loopback development.
# FLEET_RECALL_RESOURCE_URL=https://recall.example/mcp
# FLEET_RECALL_OIDC_ISSUERS=human=https://issuer.example/
# Only for an issuer lacking resource audiences; never excuses a wrong audience.
# FLEET_RECALL_OIDC_SCOPE_SUBSTITUTES=human=fleet-recall
# FLEET_RECALL_OIDC_CA_PATH=/path/to/private-ca.pem
# FLEET_RECALL_LOCAL_KEY_ANCHOR_PATH=/path/to/kid-public-key-map.json
# FLEET_RECALL_GRANT_SIGNING_KEY_HEX=<32-byte-random-Ed25519-seed-as-64-hex>
# FLEET_RECALL_GRANT_TTL_SECONDS=3600
# FLEET_RECALL_GRANT_CHECK_CACHE_SECONDS=5
# FLEET_RECALL_SCOPE_CACHE_MAX=64
# FLEET_RECALL_AGENT_CACHE_MAX=256
# FLEET_RECALL_HTTP_MAX_INFLIGHT=64
# FLEET_RECALL_HTTP_ALLOWED_ORIGINS=https://operator.example
# AWS exchange is optional; enable all three together.
# FLEET_RECALL_AWS_STS_ENDPOINT=https://sts.us-east-1.amazonaws.com/
# FLEET_RECALL_AWS_IAM_SERVER_ID=recall.example
# FLEET_RECALL_AWS_ALLOWED_ACCOUNTS=123456789012
# Workstation enrollment command ONLY; all other database URLs/content keys absent.
# FLEET_RECALL_ENROLLMENT_DATABASE_URL=postgresql://fleet_enrollment:password@host:26257/fleet_recall?sslmode=verify-full

# M3 embedding consumers keep their model name and digest; the bundle is optional.
# FLEET_RECALL_EMBEDDING_TIER_URL=https://embed.example
# FLEET_RECALL_EMBEDDING_TIER_TIMEOUT_MS=2000
# Set the same private bearer on the embedding server and its consumers.
# FLEET_RECALL_EMBEDDING_TIER_TOKEN=<private-static-token>
# Shared only between the remote receiver and the worker, never the agent.
# FLEET_RECALL_TRANSCRIPT_SPOOL_DIR=/var/lib/recall/transcripts
# Local loopback issuer routing from k0s only; production uses normal HTTPS.
# FLEET_RECALL_OIDC_LOCAL_TRANSPORTS=hydra=http://hydra-public.ory.svc.cluster.local:4444/
# Thin shim/shipper: each process gets its own delegated grant and no DB URL.
# FLEET_RECALL_URL=https://recall.example/mcp
# FLEET_RECALL_TOKEN=<delegated-session-grant>
# Launcher process only; never pass the identity seed to an agent or shipper.
# FLEET_RECALL_LAUNCHER_KEY_HEX=<enrolled-private-Ed25519-seed>
