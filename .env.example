# CockroachDB Cloud PostgreSQL connection string. Do not commit credentials.
FLEET_RECALL_DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full
# LocalStack/Compose may set this to 1 only with localhost, loopback, or the
# Compose service hostname `cockroach`; production URLs always verify TLS.
# FLEET_RECALL_ALLOW_INSECURE_LOCAL_DATABASE=1

# Stable namespace used to isolate one organization or fleet. Generate a
# different UUID for each real fleet; this non-nil value is only a demo sample.
FLEET_RECALL_TENANT_ID=0198a849-f6ae-7d61-9800-000000000001

# Deployment-bound identity. MCP callers may assert the same project/agent,
# choose a session subdivision, but cannot reroute identity or visibility.
FLEET_RECALL_PROJECT=default
FLEET_RECALL_AGENT=operator
FLEET_RECALL_MAX_CONNECTIONS=16
# Stable logical registry name. This is not resolved over the network.
FLEET_RECALL_EMBEDDING_MODEL=minishlab/potion-retrieval-32M
# Local model2vec directory baked into the runtime image. It must contain
# config.json, model.safetensors, and tokenizer.json as regular files.
FLEET_RECALL_EMBEDDING_MODEL_PATH=/opt/ostk/models/potion-retrieval-32M
# Versioned digest printed by `ostk-fleet-recall model-digest <bundle-path>`.
# Replace this placeholder before running migrate, health, serve, or ingest.
FLEET_RECALL_EMBEDDING_MODEL_SHA256=REPLACE_WITH_MODEL_DIGEST
RUST_LOG=ostk_fleet_recall=info
