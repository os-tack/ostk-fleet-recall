# Server: canonical identity, independent of its internal service addresses.
FLEET_RECALL_RESOURCE_URL=https://recall.fleet.test:8443/mcp
FLEET_RECALL_OIDC_ISSUERS=hydra=https://auth.fleet.test:8443/,k8s=https://kubernetes.default.svc
FLEET_RECALL_OAUTH_ADVERTISED_ANCHORS=hydra
FLEET_RECALL_OAUTH_SCOPES=openid,offline_access,fleet-recall
FLEET_RECALL_OIDC_SCOPE_SUBSTITUTES=hydra=fleet-recall
FLEET_RECALL_OIDC_CA_PATH=/var/run/recall/oidc-ca-bundle.pem
FLEET_RECALL_OIDC_DISCOVERY_TOKEN_PATHS=k8s=/var/run/recall-oidc/token

# Client: public CA material only, never the CA signing key.
FLEET_RECALL_URL=https://recall.fleet.test:8443/mcp
FLEET_RECALL_CA_PATH=/absolute/path/to/recall-ca-bundle.pem
# FLEET_RECALL_ALLOW_HTTP must be unset or false.
# Native Codex/browser trust must be configured separately; see README.md.
