# Replace example.com with the selected owned DNS zone before enrollment.
# Server: retain the explicit Hydra scope exception until separately qualified.
FLEET_RECALL_RESOURCE_URL=https://recall.example.com/mcp
FLEET_RECALL_OIDC_ISSUERS=hydra=https://auth.example.com/
FLEET_RECALL_OAUTH_ADVERTISED_ANCHORS=hydra
FLEET_RECALL_OAUTH_SCOPES=openid,offline_access,fleet-recall
FLEET_RECALL_OIDC_SCOPE_SUBSTITUTES=hydra=fleet-recall

# Client: publicly trusted edge certificates need no extra CA path.
FLEET_RECALL_URL=https://recall.example.com/mcp
# FLEET_RECALL_ALLOW_HTTP must be unset or false.
# Clear local OIDC transport/token/CA overrides when changing environments.
# Enrolled launcher keys and all server/provider secrets are supplied separately.
