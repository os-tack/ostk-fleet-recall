{
  "uid": "fleet-overview",
  "title": "Fleet Recall / Overview",
  "description": "Fleet health, latency, reliability, dependency pressure and worker freshness. Follow the linked dashboards for diagnosis.",
  "tags": [
    "fleet-recall",
    "operations"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Fleet Prometheus",
          "value": "fleet-prometheus"
        },
        "refresh": 1
      },
      {
        "name": "deployment",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$prometheus"
        },
        "definition": "label_values(up, deployment)",
        "query": {
          "query": "label_values(up, deployment)",
          "refId": "deployment"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "instance",
        "label": "Service instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$prometheus"
        },
        "definition": "label_values(up{job=\"fleet-recall\",deployment=~\"$deployment\"}, instance)",
        "query": {
          "query": "label_values(up{job=\"fleet-recall\",deployment=~\"$deployment\"}, instance)",
          "refId": "instance"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
