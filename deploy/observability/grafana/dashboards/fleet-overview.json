      "title": "Latest worker result",
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "description": "Succeeded, failed, or explicitly unknown per deployment/collector. A down collector or absent terminal worker outcome is unknown. Historical samples repeat the latest published snapshot, not a count or duration of runs.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Unknown",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Succeeded",
                  "color": "green"
                },
                "1": {
                  "text": "Failed",
                  "color": "red"
                },
                "2": {
                  "text": "Unknown",
                  "color": "#8e8e8e"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90,
            "spanNulls": false,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((max by (deployment,instance) (fleet_recall_operations_total{job=\"fleet-worker-textfile\",deployment=~\"$deployment\",component=\"process\",operation=\"worker\",outcome=\"error\"} or (0 * fleet_recall_operations_total{job=\"fleet-worker-textfile\",deployment=~\"$deployment\",component=\"process\",operation=\"worker\",outcome=\"success\"}))) and on (deployment,instance) (max by (deployment,instance) (up{job=\"fleet-worker-textfile\",deployment=~\"$deployment\"}) == 1)) or on (deployment,instance) (0 * max by (deployment,instance) (up{job=\"fleet-worker-textfile\",deployment=~\"$deployment\"}) + 2)",
