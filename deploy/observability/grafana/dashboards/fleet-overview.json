    {
      "id": 6,
      "type": "stat",
      "title": "MCP error fraction",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "description": "Backend errors, deadlines and cancellations divided by observed MCP traffic. Success-only traffic has a known zero numerator. No observed traffic stays unknown; refused/invalid are separate outcomes.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(fleet_recall_operations_total{job=\"fleet-recall\",deployment=~\"$deployment\",instance=~\"$instance\",component=\"mcp\",operation=~\"recall\\\\..*|remember\\\\..*\",outcome=~\"error|timeout|cancelled\"}[$__rate_interval])) or 0 * sum(rate(fleet_recall_operations_total{job=\"fleet-recall\",deployment=~\"$deployment\",instance=~\"$instance\",component=\"mcp\",operation=~\"recall\\\\..*|remember\\\\..*\"}[$__rate_interval]))) / (sum(rate(fleet_recall_operations_total{job=\"fleet-recall\",deployment=~\"$deployment\",instance=~\"$instance\",component=\"mcp\",operation=~\"recall\\\\..*|remember\\\\..*\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus"
          },
          "editorMode": "code"
        }
      ]
    },
