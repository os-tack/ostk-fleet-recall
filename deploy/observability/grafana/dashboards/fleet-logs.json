        }
      },
      "datasource": {
        "type": "loki",
        "uid": "$loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (count_over_time({job=\"kubernetes-events\",deployment=~\"$deployment\",namespace=~\"$namespace\"} | json type=\"type\" | __error__=\"\" | type=\"Warning\" [$__interval]))",
          "queryType": "range",
          "editorMode": "code",
          "datasource": {
            "type": "loki",
            "uid": "$loki"
          }
        }
      ]
    },
    {
      "id": 13,
      "title": "Kubernetes Events",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 12
      },
      "description": "Namespace-filtered cluster event stream. Pod/container filters intentionally do not apply; involved-object fields are available in log details.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "datasource": {
        "type": "loki",
        "uid": "$loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"kubernetes-events\",deployment=~\"$deployment\",namespace=~\"$namespace\"} |= ${search:doublequote}",
          "queryType": "range",
          "editorMode": "code",
          "datasource": {
            "type": "loki",
            "uid": "$loki"
          },
          "maxLines": 500
        }
      ]
    }
  ]
